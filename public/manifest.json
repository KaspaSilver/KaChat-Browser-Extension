{
  "manifest_version": 3,
  "name": "KaPay Extension",
  "short_name": "KaPay",
  "version": "5.2.2",
  "description": "KaPay, the Kaspa wallet from KaChat: send and receive KAS, manage addresses and domains, and connect to Kaspa websites.",
  "icons": {
    "16": "icons/kapay-16.png",
    "32": "icons/kapay-32.png",
    "48": "icons/kapay-48.png",
    "128": "icons/kapay-128.png"
  },
  "action": {
    "default_title": "KaPay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/kapay-16.png",
      "32": "icons/kapay-32.png",
      "48": "icons/kapay-48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "inpage.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.kaspa.org/*",
    "https://api-tn10.dotk.name/*",
    "https://api-tn10.kaspa.org/*",
    "https://api.knsdomains.org/*",
    "https://api.coingecko.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://api.gateio.ws/*",
    "https://kaspaname.com/*",
    "https://api.dotk.name/*",
    "https://*.kaspa.green/*",
    "https://*.kaspa.red/*",
    "https://*.kaspa.stream/*",
    "https://*.kaspa.blue/*",
    "https://*.kaspa.ws/*",
    "https://indexer.kachat.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "minimum_chrome_version": "116"
}
